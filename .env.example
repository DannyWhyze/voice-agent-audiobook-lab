# Copy this file to .env and fill in your own values.
# .env is gitignored — never commit real keys.

# ── LangSmith tracing (optional, for LangChain observability) ──
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=lca-lc-foundations

# ── Model download (download_model.py) ──
MODEL_NAME=fishaudio/s2-pro
# Optional: fishaudio/s2-pro itself is public, no token needed. Only
# required for gated/private HF repos.
HF_TOKEN=

# ── fishaudio S2 engine server ──
ENGINE_URL=http://127.0.0.1:3030

# ── Ollama chat agent ──
OLLAMA_MODEL=qwen3.5:latest

# ── NVIDIA NIM API key (optional, only needed for provider=nvidia in chat) ──
NVIDIA_API_KEY=
